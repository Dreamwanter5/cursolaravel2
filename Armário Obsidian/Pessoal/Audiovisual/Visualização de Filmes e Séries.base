views:
  - type: cards
    name: Filmes
    filters:
      or:
        - file.folder == "Pessoal/Audiovisual/Filmes"
        - file.folder == "Pessoal/Audiovisual/Series"
    order:
      - file.name
      - genres
      - personalRating
      - watched
    sort: []
    cardSize: 230
    image: note.image
    imageAspectRatio: 1.5
  - type: table
    name: Table
  - type: cards
    name: card
    filters:
      and:
        - file.folder == "Pessoal/Audiovisual/Filmes"
  - type: cards
    name: card 2
    filters:
      and:
        - file.folder == "Pessoal/Audiovisual/Filmes"
